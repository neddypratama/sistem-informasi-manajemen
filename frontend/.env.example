# ==========================================================
# FRONTEND CONFIGURATION TEMPLATE (React 19 + Vite)
# ==========================================================

# 1. Mode Lokal (Development di Komputer Sendiri / Laragon):
# VITE_API_URL=http://localhost:4000/api/v1

# 2. Mode Produksi cPanel (Jika Backend menggunakan subdomain terpisah):
# Contoh: Backend di https://api.bimapratama.com, Frontend di https://erp.bimapratama.com
# VITE_API_URL=https://api.bimapratama.com/api/v1

# 3. Mode Produksi cPanel (Jika Backend di-proxy ke path yang sama atau VPS reverse proxy):
# VITE_API_URL=/api/v1

VITE_API_URL=http://localhost:4000/api/v1
