# =======================================================
# Git Ignore - Bima Pratama ERP 2.0 Monorepo
# =======================================================

# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
*/dist/
dist-ssr/
*.tsbuildinfo
*/tsconfig.build.tsbuildinfo

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Database dumps & large SQL files
*.sql
*.sql.gz
*.sqlite
*.sqlite3

# Uploads & Temp files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.orig
