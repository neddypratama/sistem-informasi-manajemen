PORT=4000
NODE_ENV=development

# Database Connection (MySQL / MariaDB via Laragon or Docker)
DATABASE_URL="mysql://root:@localhost:3306/bimapratama_v2"

# JWT Authentication (Ganti dengan kunci rahasia acak minimal 32 karakter untuk produksi)
JWT_SECRET="ganti-dengan-kunci-rahasia-jwt-minimal-32-karakter-keamanan-tinggi"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="ganti-dengan-kunci-rahasia-refresh-jwt-minimal-32-karakter"
JWT_REFRESH_EXPIRES_IN="7d"

# Allowed CORS Origins (Pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Redis Cache & Queue (Opsional)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
